# Kopieer dit bestand naar .env en vul het in:  cp .env.example .env && nano .env

# --- Eufy-account voor de server (gebruik een APART account, zie handleiding) ---
EUFY_EMAIL=deurbel.server@voorbeeld.nl
EUFY_PASSWORD=wachtwoord
EUFY_COUNTRY=NL

# --- Dashboard ---
PORT=8080
# Pincode om het dashboard te openen (aanrader)
APP_PIN=1234
# Adres waarop je het dashboard opent, voor de knop in meldingen
PUBLIC_URL=http://192.168.1.10:8080
# Alleen invullen als je meerdere Eufy-apparaten hebt en er één wilt tonen
DEVICE_SERIAL=

# --- Meldingen op je telefoon via de ntfy-app ---
# Verzin een lange, onraadbare naam; iedereen die hem kent kan meelezen
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
# --- Opnames ---
# Beginwaarde voor de opslaglimiet in GB (later aan te passen in het dashboard)
STORAGE_GB=10
# Automatisch downloaden: important (aanbellen/personen), all of off
AUTO_DOWNLOAD=important

# --- Verbinding met je HomeBase (optioneel, maakt live beeld sneller/betrouwbaarder) ---
# Formaat: serienummer-homebase:ip-adres
STATION_IP_ADDRESSES=
P2P_CONNECTION_SETUP=0

# --- Automatische updates via GitHub ---
# Map waar de app staat (vult install.sh zelf in)
HOST_DIR=/home/gebruiker/deurbel
AUTO_UPDATE=true
UPDATE_HOURS=6
# Ook eufy-security-ws (de koppeling met Eufy) automatisch bijwerken
UPDATE_EUFY=true
